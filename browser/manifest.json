{
  "manifest_version": 3,
  "name": "Kora Download Manager",
  "version": "0.4.0",
  "description": "Queue videos and detect accessible media in a selected tab.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
